{
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^f[1-9][0-9]{0,2}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "wrong_subject",
              "wrong_period",
              "wrong_granularity",
              "does_not_answer",
              "uncertain"
            ]
          }
        },
        "required": [
          "field",
          "verdict"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false
}
