{
  "type": "object",
  "properties": {
    "issues": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "enum": ["layout", "content", "legibility", "other"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 600 }
